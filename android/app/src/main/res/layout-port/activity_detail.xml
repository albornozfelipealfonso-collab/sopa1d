<?xml version="1.0" encoding="utf-8"?>
<!-- Ficha en el celular (vertical): portada arriba y todo lo demás debajo.
     Mismos ids que la versión de TV. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sopa_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="240dp">

            <ImageView
                android:id="@+id/detailBackdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/hero_scrim" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/detailTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:shadowColor="#CC000000"
                android:shadowRadius="8"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#F5C518"
                android:textSize="14sp" />

            <!-- Botones a lo ancho, como en la app de Netflix -->
            <TextView
                android:id="@+id/btnPlay"
                style="@style/TvButton"
                android:layout_width="match_parent"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_primary"
                android:textColor="#07080C"
                android:minWidth="0dp"
                android:textSize="17sp"
                android:text="▶  Ver ahora" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnMyList"
                    style="@style/TvButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:textSize="15sp"
                    android:text="＋  Mi lista" />

                <TextView
                    android:id="@+id/btnLanguage"
                    style="@style/TvButton"
                    android:layout_width="0dp"
                    android:layout_marginLeft="8dp"
                    android:layout_weight="1"
                    android:minWidth="0dp"
                    android:textSize="15sp"
                    android:text="🌐  Latino" />
            </LinearLayout>

            <TextView
                android:id="@+id/detailOverview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="3dp"
                android:textColor="#E6FFFFFF"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/seasonsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Temporadas"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/seasonsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/episodesLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Episodios"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/episodesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
