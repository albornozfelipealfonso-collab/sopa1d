<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Pantalla dividida: segundo canal, sin sonido, en la esquina -->
    <FrameLayout
        android:id="@+id/miniFrame"
        android:layout_width="320dp"
        android:layout_height="180dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginRight="32dp"
        android:background="#E6FFFFFF"
        android:focusable="false"
        android:padding="2dp"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/miniView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:focusable="false"
            app:shutter_background_color="#000000"
            app:surface_type="texture_view"
            app:use_controller="false" />

        <TextView
            android:id="@+id/miniLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#B3000000"
            android:ellipsize="end"
            android:paddingLeft="8dp"
            android:paddingTop="3dp"
            android:paddingRight="8dp"
            android:paddingBottom="3dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Rótulo que aparece al cambiar de canal -->
    <TextView
        android:id="@+id/channelBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="28dp"
        android:background="#CC07080C"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Rótulo de canal estilo TV: franja inferior con número, logo y nombre -->
    <LinearLayout
        android:id="@+id/channelOsd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/osd_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="48dp"
        android:paddingTop="60dp"
        android:paddingRight="48dp"
        android:paddingBottom="36dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/osdNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="90dp"
            android:fontFamily="sans-serif-black"
            android:textColor="#E50914"
            android:textSize="54sp" />

        <ImageView
            android:id="@+id/osdLogo"
            android:layout_width="120dp"
            android:layout_height="68dp"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="20dp"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/osdName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <!-- Guía: lo que se emite ahora, su avance y lo que sigue -->
            <TextView
                android:id="@+id/osdNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/osdProgress"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="420dp"
                android:layout_height="4dp"
                android:layout_marginTop="6dp"
                android:max="1000"
                android:progressDrawable="@drawable/progress_red"
                android:visibility="gone" />

            <TextView
                android:id="@+id/osdNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="15sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/osdInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#80FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/osdClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E50914"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:text="● EN VIVO"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Celular: botones grandes para cambiar de canal sin control -->
    <LinearLayout
        android:id="@+id/liveTouchControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView android:id="@+id/touchDown" style="@style/TouchButton" android:text="▼  Anterior" />
        <TextView android:id="@+id/touchBack" style="@style/TouchButton" android:text="⇄" />
        <TextView android:id="@+id/touchList" style="@style/TouchButton" android:text="☰  Canales" />
        <TextView android:id="@+id/touchGuide" style="@style/TouchButton" android:text="📅  Guía" />
        <TextView android:id="@+id/touchFav" style="@style/TouchButton" android:text="☆  Favorito" />
        <TextView android:id="@+id/touchUp" style="@style/TouchButton" android:text="Siguiente  ▲" />
    </LinearLayout>

    <!-- Celular: pasar el canal a la TV -->
    <TextView
        android:id="@+id/liveSendToTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:background="@drawable/button_bg"
        android:clickable="true"
        android:focusable="false"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp"
        android:paddingBottom="8dp"
        android:text="📺  Enviar a la TV"
        android:textColor="@color/button_text"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Estado de carga / reconexión -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC07080C"
        android:padding="18dp"
        android:textColor="#F5C518"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- Programación del canal actual (◀) -->
    <LinearLayout
        android:id="@+id/schedulePanel"
        android:layout_width="520dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#F207080C"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/scheduleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="24dp"
            android:paddingTop="22dp"
            android:paddingRight="24dp"
            android:paddingBottom="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E50914"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingLeft="24dp"
            android:paddingBottom="12dp"
            android:text="Programación de hoy y mañana"
            android:textColor="#80FFFFFF"
            android:textSize="14sp" />

        <ListView
            android:id="@+id/scheduleList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#22FFFFFF"
            android:dividerHeight="1dp"
            android:cacheColorHint="@android:color/transparent"
            android:listSelector="@drawable/channel_item_bg" />
    </LinearLayout>

    <!-- Panel lateral de zapping -->
    <LinearLayout
        android:id="@+id/channelPanel"
        android:layout_width="440dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="#EE07080C"
        android:visibility="gone">

        <!-- Categoría de la lista: OK (o ◀ ▶) pasa a la siguiente; ▼ entra a los canales -->
        <TextView
            android:id="@+id/channelCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/button_bg"
            android:clickable="true"
            android:focusable="true"
            android:paddingLeft="14dp"
            android:paddingTop="12dp"
            android:paddingRight="14dp"
            android:paddingBottom="12dp"
            android:text="@string/channels_title"
            android:textColor="@color/button_text"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Celular: filtrar entre miles de canales escribiendo el nombre -->
        <EditText
            android:id="@+id/channelSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginRight="14dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/search_bg"
            android:hint="🔍  Buscar canal (tnt, espn, mega…)"
            android:imeOptions="actionSearch|flagNoExtractUi|flagNoFullscreen"
            android:inputType="text"
            android:maxLines="1"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#80FFFFFF"
            android:textSize="16sp"
            android:visibility="visible" />

        <ListView
            android:id="@+id/channelList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#22FFFFFF"
            android:dividerHeight="1dp"
            android:cacheColorHint="@android:color/transparent" />
    </LinearLayout>

</FrameLayout>
