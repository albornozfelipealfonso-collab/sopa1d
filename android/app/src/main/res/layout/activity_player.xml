<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Rótulo que aparece al cambiar de canal -->
    <TextView
        android:id="@+id/channelBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="28dp"
        android:background="#CC07080C"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Estado de carga / reconexión -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC07080C"
        android:padding="18dp"
        android:textColor="#F5C518"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- Panel lateral de zapping -->
    <LinearLayout
        android:id="@+id/channelPanel"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="#EE07080C"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="18dp"
            android:text="@string/channels_title"
            android:textColor="#E11D48"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/channelList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#22FFFFFF"
            android:dividerHeight="1dp"
            android:cacheColorHint="@android:color/transparent" />
    </LinearLayout>

</FrameLayout>
