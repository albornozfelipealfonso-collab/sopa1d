<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla principal de TV: cartelera de fondo, menú a la izquierda que se
     encoge a íconos, filas de carátulas, y la entrada animada encima. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sopa_bg">

    <!-- Cartelera: portada del título enfocado, a la derecha y arriba -->
    <ImageView
        android:id="@+id/heroBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="300dp"
        android:alpha="0.9"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="300dp"
        android:background="@drawable/hero_scrim_left" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <!-- Menú lateral: solo íconos; se despliega al entrar en él -->
        <LinearLayout
            android:id="@+id/tvNav"
            android:layout_width="92dp"
            android:layout_height="match_parent"
            android:background="@drawable/nav_bg"
            android:orientation="vertical"
            android:paddingTop="28dp">

            <TextView
                android:id="@+id/navLogo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingLeft="28dp"
                android:paddingBottom="30dp"
                android:singleLine="true"
                android:text="🍜"
                android:textColor="#E11D48"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Para "Ver en la TV" desde el celular, si la red no la encuentra sola -->
            <TextView
                android:id="@+id/navIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-20dp"
                android:paddingLeft="28dp"
                android:paddingBottom="18dp"
                android:singleLine="true"
                android:textColor="#80FFFFFF"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView android:id="@+id/navHome" style="@style/TvNavItem" android:tag="🏠|Inicio" android:text="🏠" />
            <TextView android:id="@+id/navSearch" style="@style/TvNavItem" android:tag="🔍|Buscar" android:text="🔍" />
            <TextView android:id="@+id/navMovies" style="@style/TvNavItem" android:tag="🎬|Películas" android:text="🎬" />
            <TextView android:id="@+id/navSeries" style="@style/TvNavItem" android:tag="📺|Series" android:text="📺" />
            <TextView android:id="@+id/navAnime" style="@style/TvNavItem" android:tag="🌸|Anime" android:text="🌸" />
            <TextView android:id="@+id/navLive" style="@style/TvNavItem" android:tag="📡|TV en Vivo" android:text="📡" />
            <TextView android:id="@+id/navMusic" style="@style/TvNavItem" android:tag="🎸|Música" android:text="🎸" />
            <TextView android:id="@+id/navGuide" style="@style/TvNavItem" android:tag="🗓️|Guía TV" android:text="🗓️" />
            <TextView android:id="@+id/navMyList" style="@style/TvNavItem" android:tag="❤️|Mi lista" android:text="❤️" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView android:id="@+id/navWeb" style="@style/TvNavItem"
                android:layout_marginBottom="24dp"
                android:tag="🌐|Versión web"
                android:text="🌐" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Datos del título enfocado -->
            <LinearLayout
                android:id="@+id/heroInfo"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:orientation="vertical"
                android:paddingLeft="48dp"
                android:paddingTop="40dp"
                android:paddingRight="360dp">

                <TextView
                    android:id="@+id/heroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-condensed"
                    android:maxLines="1"
                    android:shadowColor="#CC000000"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textColor="#FFFFFF"
                    android:textSize="40sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/heroChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/heroOverview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="3"
                    android:shadowColor="#CC000000"
                    android:shadowRadius="6"
                    android:textColor="#E6FFFFFF"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- Buscador (solo en la sección Buscar) -->
            <EditText
                android:id="@+id/searchBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="48dp"
                android:layout_marginRight="48dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/search_bg"
                android:hint="🔍  Escribe una película, serie o anime"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:padding="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#80FFFFFF"
                android:textSize="18sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="160dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/homeMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginLeft="92dp"
        android:textColor="#B3FFFFFF"
        android:textSize="18sp"
        android:visibility="gone" />

    <!-- Entrada animada al abrir la app -->
    <FrameLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/splashLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:shadowColor="#E11D48"
            android:shadowRadius="40"
            android:text="SOPA1D"
            android:textColor="#E11D48"
            android:textSize="96sp" />
    </FrameLayout>
</FrameLayout>
