<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/vodPlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        app:show_buffering="when_playing"
        app:show_subtitle_button="true"
        app:keep_content_on_player_reset="true" />

    <!-- Título y ayuda de teclas, arriba -->
    <LinearLayout
        android:id="@+id/vodTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/top_scrim"
        android:orientation="vertical"
        android:paddingLeft="48dp"
        android:paddingTop="28dp"
        android:paddingRight="48dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/vodTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/vodSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp" />

        <!-- Celular: botones (en la TV se usan ▲ y MENÚ del control) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

        <TextView
            android:id="@+id/vodServers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="10dp"
            android:background="@drawable/button_bg"
            android:clickable="true"
            android:focusable="true"
            android:paddingLeft="16dp"
            android:paddingTop="8dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"
            android:text="🌐  Idioma y servidor"
            android:textColor="@color/button_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/vodSendToTv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_bg"
            android:clickable="true"
            android:focusable="true"
            android:paddingLeft="16dp"
            android:paddingTop="8dp"
            android:paddingRight="16dp"
            android:paddingBottom="8dp"
            android:text="📺  Enviar a la TV"
            android:textColor="@color/button_text"
            android:textSize="15sp"
            android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Series: saltar la intro -->
    <TextView
        android:id="@+id/vodSkipIntro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginRight="48dp"
        android:layout_marginBottom="120dp"
        android:background="@drawable/button_bg"
        android:clickable="true"
        android:focusable="true"
        android:paddingLeft="22dp"
        android:paddingTop="12dp"
        android:paddingRight="22dp"
        android:paddingBottom="12dp"
        android:text="⏭  Saltar intro"
        android:textColor="@color/button_text"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Series: siguiente episodio con cuenta regresiva -->
    <LinearLayout
        android:id="@+id/vodNextCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginRight="48dp"
        android:layout_marginBottom="110dp"
        android:background="@drawable/status_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/vodNextImage"
            android:layout_width="160dp"
            android:layout_height="90dp"
            android:background="#1A1D29"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/vodNextTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/vodNextCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/vodNextNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_bg"
                android:duplicateParentState="true"
                android:paddingLeft="16dp"
                android:paddingTop="6dp"
                android:paddingRight="16dp"
                android:paddingBottom="6dp"
                android:text="▶  Ver ahora   (Atrás: cancelar)"
                android:textColor="@color/button_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Estado mientras se busca servidor -->
    <LinearLayout
        android:id="@+id/vodStatusBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/status_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="#E11D48" />

        <TextView
            android:id="@+id/vodStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Panel lateral: idioma / servidor -->
    <LinearLayout
        android:id="@+id/vodPanel"
        android:layout_width="380dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#F00B0D14"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:text="Calidad, idioma y servidor"
            android:textColor="#E11D48"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/vodServerList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:choiceMode="singleChoice"
            android:divider="@null"
            android:listSelector="@drawable/channel_item_bg" />
    </LinearLayout>
</FrameLayout>
