<?xml version="1.0" encoding="utf-8"?>
<!-- Inicio en el celular (vertical), estilo app de Netflix: portada destacada
     arriba, filas de carátulas y barra de secciones abajo. Usa los mismos ids
     que la versión de TV, así el código es el mismo. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sopa_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Portada destacada -->
        <FrameLayout
            android:id="@+id/heroInfo"
            android:layout_width="match_parent"
            android:layout_height="@dimen/phone_hero_height"
            android:clickable="true"
            android:focusable="false">

            <ImageView
                android:id="@+id/heroBackdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/hero_scrim" />

            <TextView
                android:id="@+id/navLogo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:shadowColor="#CC000000"
                android:shadowRadius="8"
                android:text="🍜 SOPA1D"
                android:textColor="#E11D48"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/heroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-condensed"
                    android:maxLines="2"
                    android:shadowColor="#CC000000"
                    android:shadowRadius="8"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/heroChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/heroOverview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:shadowColor="#CC000000"
                    android:shadowRadius="6"
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <EditText
            android:id="@+id/searchBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:background="@drawable/search_bg"
            android:hint="🔍  Película, serie o anime"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:padding="14dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#80FFFFFF"
            android:textSize="16sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="24dp" />

        <!-- Barra de secciones -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F205060A"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tvNav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView android:id="@+id/navHome" style="@style/PhoneNavItem" android:tag="🏠|Inicio" android:text="🏠\nInicio" />
                <TextView android:id="@+id/navSearch" style="@style/PhoneNavItem" android:tag="🔍|Buscar" android:text="🔍\nBuscar" />
                <TextView android:id="@+id/navMovies" style="@style/PhoneNavItem" android:tag="🎬|Películas" android:text="🎬\nPelículas" />
                <TextView android:id="@+id/navSeries" style="@style/PhoneNavItem" android:tag="📺|Series" android:text="📺\nSeries" />
                <TextView android:id="@+id/navAnime" style="@style/PhoneNavItem" android:tag="🌸|Anime" android:text="🌸\nAnime" />
                <TextView android:id="@+id/navLive" style="@style/PhoneNavItem" android:tag="📡|En vivo" android:text="📡\nEn vivo" />
                <TextView android:id="@+id/navMusic" style="@style/PhoneNavItem" android:tag="🎸|Música" android:text="🎸\nMúsica" />
                <TextView android:id="@+id/navGuide" style="@style/PhoneNavItem" android:tag="🗓️|Guía" android:text="🗓️\nGuía" />
                <TextView android:id="@+id/navMyList" style="@style/PhoneNavItem" android:tag="❤️|Mi lista" android:text="❤️\nMi lista" />
                <TextView android:id="@+id/navWeb" style="@style/PhoneNavItem" android:tag="🌐|Web" android:text="🌐\nWeb" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Solo en la TV -->
        <TextView
            android:id="@+id/navIp"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/homeMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="24dp"
        android:textColor="#B3FFFFFF"
        android:textSize="16sp"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/splashLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:shadowColor="#E11D48"
            android:shadowRadius="40"
            android:text="SOPA1D"
            android:textColor="#E11D48"
            android:textSize="64sp" />
    </FrameLayout>
</FrameLayout>
